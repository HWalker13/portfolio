#!/usr/bin/env python3
"""kc PORT COMMAND... : send one raw Kache protocol command and print the server's reply verbatim."""
import socket
import sys

port, cmd = int(sys.argv[1]), " ".join(sys.argv[2:])
with socket.create_connection(("127.0.0.1", port)) as s:
    s.sendall((cmd + "\n").encode())
    f = s.makefile("r")
    while True:
        line = f.readline().rstrip("\n")
        print(line)
        if not line.startswith("*"):  # KEYS streams *key lines and ends with +done / +none
            break
