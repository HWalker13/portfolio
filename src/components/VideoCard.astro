---
/*
  A demo card for the project reel. Two variants of the same card:
    wheel  - on the curved wheel (desktop, motion OK). Transforms are set by src/scripts/reel.ts.
    inline - flat, inside the project's own section (phones, and everyone with reduced motion).

  The whole card is one link to where the project lives (frontmatter `link`), in a new tab. The
  video inside is decorative: muted, looped, playsinline, preload="none", never focusable, and
  played or paused only by src/scripts/reel.ts (the focused / visible card plays; "Pause motion"
  and reduced motion stop it and leave the poster). Its poster frame is a lazy-loaded <img>.
  Without a video: a static card with the project name and where it's live.

  Layers, bottom to top, all inside .face (which lifts on hover, so the wheel's own transform on
  the card is never touched): poster (image or static card), video, fringe, the "↗ Visit" tag.
  The chromatic-aberration fringe is a static red/cyan edge shadow whose opacity the wheel
  sets per frame (opacity only, so it's free on the compositor). It's never applied to the
  live video, only to the card edge around the poster layer, and only off-focus.
*/
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  index: number;
  variant: 'wheel' | 'inline';
}
const { entry, index, variant } = Astro.props;
const { title, video, proof, link } = entry.data;

// Static-card inks: each a field deep brown text passes on (≥4.9:1), plus two accent stripes.
const LOOKS = [
  { bg: 'var(--burnt-orange)', a: 'var(--mustard)', b: 'var(--cream)' },
  { bg: 'var(--mustard)', a: 'var(--burnt-orange)', b: 'var(--chocolate)' },
  { bg: 'var(--powder)', a: 'var(--slate)', b: 'var(--burnt-orange)' },
  { bg: 'var(--cream)', a: 'var(--avocado)', b: 'var(--mustard)' },
];
const look = LOOKS[index % LOOKS.length];
const num = String(index + 1).padStart(2, '0');

// Static card: where the project lives, preferring the App Store, then PyPI, then GitHub.
const WHERE = {
  appstore: { status: 'Live on the App Store' },
  pypi: { status: 'Published on PyPI' },
  github: { status: 'Open source on GitHub' },
} as const;
const home = (['appstore', 'pypi', 'github'] as const).map((k) => proof.find((p) => p.kind === k)).find(Boolean)!;
const where = WHERE[home.kind];
---

<a
  class:list={['vcard', `vcard--${variant}`, video && `vcard--${video.frame}`]}
  href={link.url}
  target="_blank"
  rel="noopener"
  data-card={index}
  data-variant={variant}
  style={`--sc-bg:${look.bg};--sc-a:${look.a};--sc-b:${look.b}`}
>
  {/* The name leads with the word the tag shows, so "click Visit" works for voice control */}
  <span class="visually-hidden">Visit {link.name} (opens in a new tab)</span>
  <span class="face" aria-hidden="true">
    {
      video ? (
        <>
          <span class="poster-layer">
            <img src={video.poster} alt="" loading="lazy" decoding="async" />
          </span>
          {/* No poster attribute: browsers fetch a video poster eagerly. The lazy <img> above shows it. */}
          <video muted loop playsinline preload="none" tabindex="-1">
            {video.webm && <source src={video.webm} type="video/webm" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
        </>
      ) : (
        <span class="sc">
          <span class="sc-stripes" />
          <span class="sc-num">{num}</span>
          <span class="sc-name">{title}</span>
          <span class="sc-status">{where.status}</span>
        </span>
      )
    }
    <span class="fringe"></span>
    <span class="visit">↗ Visit</span>
  </span>
</a>

<style>
  .vcard {
    position: relative;
    display: block;
    margin: 0;
    aspect-ratio: 16 / 10;
    border-radius: 18px;
    color: var(--deep-brown);
    text-decoration: none;
    cursor: pointer;
  }
  .vcard:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 5px;
  }
  .face {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
    overflow: hidden;
    background: var(--sc-bg);
    box-shadow:
      0 0 0 3px var(--deep-brown),
      0 26px 50px -22px rgb(0 0 0 / 0.7);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* Hover cue: a slight lift. Kept off the wheel's own transform, which lives on .vcard. */
  .vcard:hover .face,
  .vcard:focus-visible .face {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 3px var(--deep-brown),
      0 34px 56px -22px rgb(0 0 0 / 0.75);
  }
  @media (prefers-reduced-motion: reduce) {
    .face {
      transition: none;
    }
    .vcard:hover .face,
    .vcard:focus-visible .face {
      transform: none;
    }
  }
  .poster-layer,
  .poster-layer img,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster-layer img,
  video {
    object-fit: cover;
  }
  /* Phone recordings: letterboxed inside a phone outline on the card's field */
  .vcard--phone video,
  .vcard--phone .poster-layer img {
    object-fit: contain;
    padding: 6% 0;
  }

  /* ── "↗ Visit": top right (the recordings keep that corner quiet), shown on hover / focus ── */
  .visit {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    padding: 0.3em 0.8em;
    border-radius: 999px;
    background: var(--paper);
    color: var(--chocolate);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 3px 0 var(--deep-brown);
    opacity: 0;
    transform: translateY(-3px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .vcard:hover .visit,
  .vcard:focus-visible .visit {
    opacity: 1;
    transform: none;
  }
  /* Touch screens never hover: keep the tag showing so the card reads as a link */
  @media (hover: none) {
    .visit {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Static card (no video) ─────────────────────────────────────────── */
  .sc {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 0.35rem;
    padding: clamp(1rem, 4%, 1.6rem);
    color: var(--deep-brown);
  }
  /* A corner supergraphic: three quarter-circle bands in the top right */
  .sc-stripes {
    position: absolute;
    top: 0;
    right: 0;
    width: 58%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle at 100% 0,
      var(--sc-a) 0 18%,
      transparent 18.5% 26%,
      var(--sc-b) 26.5% 38%,
      transparent 38.5% 46%,
      var(--sc-a) 46.5% 58%,
      transparent 58.5%
    );
  }
  .sc-num {
    position: relative;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .sc-name {
    position: relative;
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    line-height: 1;
  }
  .sc-status {
    position: relative;
    font-weight: 700;
    font-size: 1rem;
  }
  /* ── Fringe (off-focus only; the wheel drives its opacity) ───────────── */
  .fringe {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      inset 5px 0 0 rgb(255 40 70 / 0.55),
      inset -5px 0 0 rgb(0 210 255 / 0.5),
      inset 0 3px 0 rgb(255 40 70 / 0.3),
      inset 0 -3px 0 rgb(0 210 255 / 0.3);
  }
</style>
