---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer container">
  <div class="contact">
    <p class="say">Get in touch</p>
    <a class="email" href={`mailto:${site.links.email}`}>{site.links.email}</a>
  </div>
  <ul class="links">
    <li><a href={site.links.github}>GitHub</a></li>
    <li><a href={site.links.linkedin}>LinkedIn</a></li>
    <li><a href={site.links.resume}>Resume (PDF)</a></li>
  </ul>
  <p class="colophon">
    © {year} {site.name}. Built with <a href="https://astro.build">Astro</a>. No cookies, no analytics.
  </p>
</footer>

<style>
  .footer {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
  }
  .say {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 800;
    font-size: var(--step-2);
  }
  .email {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-weight: 600;
  }
  .links a {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .colophon {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .colophon a {
    color: inherit;
  }
</style>
