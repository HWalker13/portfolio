---
/*
  Footer strip. On the home page the corkboard above already holds every contact link, so it's
  just the colophon (compact). Inner pages get the contact links too.
*/
import { site } from '../data/site';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    {
      !compact && (
        <ul class="links">
          <li>
            <a href={`mailto:${site.links.email}`}>{site.links.email}</a>
          </li>
          <li>
            <a href={site.links.github}>GitHub</a>
          </li>
          <li>
            <a href={site.links.linkedin}>LinkedIn</a>
          </li>
          <li>
            <a href={site.links.resume}>Resume (PDF)</a>
          </li>
        </ul>
      )
    }
    <p class="colophon">
      © {year} {site.name}. No cookies, no analytics.
    </p>
  </div>
</footer>

<style>
  .footer {
    --focus: var(--mustard);
    background: var(--colophon-bg);
    color: var(--colophon-text);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
  }
  a {
    color: var(--colophon-text);
    text-decoration-color: var(--burnt-orange);
  }
  a:hover {
    color: var(--mustard);
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    font-weight: 600;
  }
  .links a {
    display: inline-block;
    padding-block: 0.6rem;
    overflow-wrap: anywhere;
  }
  .colophon {
    font-size: var(--step--1);
    color: var(--colophon-muted);
  }
</style>
