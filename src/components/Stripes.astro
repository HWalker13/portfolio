---
/** Stacked 70s stripes used as a section divider. Purely decorative. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['stripes', className]} aria-hidden="true">
  <span></span><span></span><span></span>
</div>

<style>
  .stripes {
    display: grid;
    gap: 4px;
    width: 100%;
    margin-block: var(--space-5);
  }
  .stripes span {
    display: block;
    height: 8px;
    border-radius: 999px;
  }
  .stripes span:nth-child(1) {
    background: var(--stripe-1);
  }
  .stripes span:nth-child(2) {
    background: var(--stripe-2);
  }
  .stripes span:nth-child(3) {
    background: var(--stripe-3);
  }
</style>
