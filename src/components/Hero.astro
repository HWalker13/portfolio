---
/*
  Hero: the turntable on the shag rug. Rug styles live in src/styles/surfaces.css.
  The album sleeve (Tracklist) overlaps the rug's bound edge.
*/
import Turntable from './Turntable.astro';
import { site } from '../data/site';
---

<section class="rug" aria-label="Introduction">
  <div class="container hero">
    <div class="intro">
      <p class="eyebrow"><span>{site.school}</span> <span aria-hidden="true">·</span> <span>{site.graduation}</span></p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <!-- DRAFT: Holden to edit -->
      <p class="looking">{site.lookingFor}</p>

      <nav aria-label="Primary links">
        <ul class="pills">
          <li><a class="pill" href={site.links.github}>GitHub</a></li>
          <li><a class="pill" href={site.links.linkedin}>LinkedIn</a></li>
          <li><a class="pill" href={site.links.resume}>Resume <span class="pill-note">(PDF)</span></a></li>
          <li><a class="pill" href={`mailto:${site.links.email}`}>Email</a></li>
        </ul>
      </nav>
    </div>

    <div class="deck">
      <Turntable />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-6);
    }
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--on-rug-muted);
  }
  /* Each phrase wraps as a unit, so a phone never shows "Graduating" alone on a line */
  .eyebrow span {
    white-space: nowrap;
  }
  h1 {
    margin-top: var(--space-2);
    color: var(--on-rug);
    font-size: clamp(2.8rem, 2rem + 4.2vw, 5.2rem);
    line-height: 0.95;
    text-shadow: 0 2px 0 rgb(0 0 0 / 0.25);
  }
  .tagline {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--on-rug);
  }
  .looking {
    margin-top: var(--space-3);
    color: var(--on-rug-muted);
  }

  .pills {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0.75rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    padding: 0.55em 1em;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-text);
    font-weight: 700;
    text-decoration: none;
    /* Orange as an accent only: it can't be text on green (3.4:1). */
    box-shadow:
      0 3px 0 var(--pill-accent),
      0 8px 18px -8px rgb(0 0 0 / 0.6);
    transition:
      background-color 120ms ease,
      transform 120ms ease;
  }
  .pill:hover {
    background: var(--pill-bg-hover);
    color: var(--pill-text);
  }
  .pill:active {
    transform: translateY(2px);
    box-shadow:
      0 1px 0 var(--pill-accent),
      0 4px 10px -6px rgb(0 0 0 / 0.6);
  }
  .pill-note {
    font-weight: 500;
  }

  .deck {
    display: grid;
    justify-items: center;
  }
</style>
