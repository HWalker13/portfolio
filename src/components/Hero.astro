---
/*
  Hero: the turntable on a shag rug.
  The rug is three static background layers (vignette/scrim gradient, a pre-generated tile, a base color),
  so nothing behind the spinning record ever repaints.
  The bottom edge is a bound rug edge with a fringe. The album sleeve (Tracklist) overlaps it.
*/
import Turntable from './Turntable.astro';
import { site } from '../data/site';
---

<section class="rug" aria-label="Introduction">
  <div class="container hero">
    <div class="intro">
      <p class="eyebrow"><span>{site.school}</span> <span aria-hidden="true">·</span> <span>{site.graduation}</span></p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <!-- DRAFT: Holden to edit -->
      <p class="looking">{site.lookingFor}</p>

      <nav aria-label="Primary links">
        <ul class="pills">
          <li><a class="pill" href={site.links.github}>GitHub</a></li>
          <li><a class="pill" href={site.links.linkedin}>LinkedIn</a></li>
          <li><a class="pill" href={site.links.resume}>Resume <span class="pill-note">(PDF)</span></a></li>
          <li><a class="pill" href={`mailto:${site.links.email}`}>Email</a></li>
        </ul>
      </nav>
    </div>

    <div class="deck">
      <Turntable />
    </div>
  </div>
</section>

<style>
  .rug {
    /* Focus rings on the rug use mustard; chocolate would disappear on dark green. */
    --focus: var(--focus-on-rug);

    position: relative;
    color: var(--on-rug);
    background:
      radial-gradient(
        ellipse 120% 95% at 50% 38%,
        rgb(var(--rug-scrim) / var(--rug-scrim-min)) 0%,
        rgb(var(--rug-scrim) / var(--rug-scrim-min)) 40%,
        rgb(var(--rug-scrim) / var(--rug-scrim-max)) 100%
      ),
      var(--rug-image) 0 0 / 256px 256px repeat,
      var(--rug-base);
    /* Bound edge of the rug */
    border-bottom: 12px solid var(--rug-binding);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(7rem, 12vw, 9rem);
  }

  /* Stitching along the binding */
  .rug::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      rgb(243 230 204 / 0.35) 0 7px,
      transparent 7px 13px
    );
  }

  /* Fringe hanging off the edge onto the floor */
  .rug::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 12px);
    height: 14px;
    background: repeating-linear-gradient(
      90deg,
      var(--rug-fiber) 0 2px,
      transparent 2px 4px,
      var(--rug-binding) 4px 6px,
      transparent 6px 8px
    );
    -webkit-mask-image: linear-gradient(#000 40%, transparent);
    mask-image: linear-gradient(#000 40%, transparent);
    pointer-events: none;
  }

  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-6);
    }
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--on-rug-muted);
  }
  /* Each phrase wraps as a unit, so a phone never shows "Graduating" alone on a line */
  .eyebrow span {
    white-space: nowrap;
  }
  h1 {
    margin-top: var(--space-2);
    color: var(--on-rug);
    font-size: clamp(2.8rem, 2rem + 4.2vw, 5.2rem);
    line-height: 0.95;
    text-shadow: 0 2px 0 rgb(0 0 0 / 0.25);
  }
  .tagline {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--on-rug);
  }
  .looking {
    margin-top: var(--space-3);
    color: var(--on-rug-muted);
  }

  .pills {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0.75rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    padding: 0.55em 1em;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-text);
    font-weight: 700;
    text-decoration: none;
    /* Orange as an accent only: it can't be text on green (3.4:1). */
    box-shadow:
      0 3px 0 var(--pill-accent),
      0 8px 18px -8px rgb(0 0 0 / 0.6);
    transition:
      background-color 120ms ease,
      transform 120ms ease;
  }
  .pill:hover {
    background: var(--pill-bg-hover);
    color: var(--pill-text);
  }
  .pill:active {
    transform: translateY(2px);
    box-shadow:
      0 1px 0 var(--pill-accent),
      0 4px 10px -6px rgb(0 0 0 / 0.6);
  }
  .pill-note {
    font-weight: 500;
  }

  .deck {
    display: grid;
    justify-items: center;
  }
</style>
