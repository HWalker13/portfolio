---
/*
  Eyes band: a half-drop repeat of hand-inked 1960s pop-art eyes on a red-orange strip, like a
  printed textile. Six original designs, cycled, with six iris colors. Decorative: aria-hidden.

  The art and the layout live in src/scripts/eye-art.ts (plain data, tested in eyes.test.ts).
  Each design and each iris color is drawn ONCE, as symbols in a hidden sprite; every eye on the
  strip is a few <use> references to them, so the pattern costs little DOM. Each breakpoint has its own grid
  (phone, mid, desktop), scaled so the same number of rows shows at every width; positions are
  percentages of a strip that keeps its aspect ratio, and the pattern bleeds off every edge.

  Per eye, bottom to top: lid color / petals (and the wave crests, `.calm`, which eyes.ts flattens
  as the eye falls asleep), the white (the largest opening the lids ever leave),
  then, clipped to it: the iris layer (`.look`; src/scripts/eyes.ts slides it toward the cursor),
  the corner hatching, the lower lid (`.cover`) and the upper eyelid (`.lid`, with its shadow and
  the closed-lid painting); then the static ink (crease), the ink that rides on the upper lid
  (`.upper`: liner, lashes) and on the lower lid (`.lower`, with any lashes that hang from the
  closed lash line, `.drop`). eyes.ts moves the lids with the gaze and slides the eyelid down for
  droops, blinks and sleep, transform only.
*/
import { ART, BELOW_PATH, DESIGNS, IRISES, IRIS_ART, LID_GEOM, OPEN_MAX_PATH, PATTERNS, SHADE, VB } from '../scripts/eye-art';

const layouts = PATTERNS.map(({ L, placed }) => ({
  key: L.key,
  aspect: `${L.W} / ${L.H}`,
  eyes: placed.map((p) => {
    const h = p.w * (VB.h / VB.w);
    return {
      design: p.design,
      iris: p.iris,
      col: p.col,
      row: p.row,
      style: [
        `left:${(((p.cx - p.w / 2) / L.W) * 100).toFixed(2)}%`,
        `top:${(((p.cy - h / 2) / L.H) * 100).toFixed(2)}%`,
        `width:${((p.w / L.W) * 100).toFixed(2)}%`,
        `rotate:${p.rot.toFixed(1)}deg`,
      ].join(';'),
    };
  }),
}));
const vb = `${VB.x} ${VB.y} ${VB.w} ${VB.h}`;
const box = { x: VB.x, y: VB.y, width: VB.w, height: VB.h };
const LAYERS = ['behind', 'calm', 'front', 'upper', 'lower', 'lid', 'cover', 'drop'] as const;
const lid = JSON.stringify(Object.fromEntries(Object.entries(LID_GEOM).map(([k, v]) => [k, +v.toFixed(4)])));
---

<div class="eyes-band" aria-hidden="true" data-eyes data-lid={lid}>
  <span class="grain"></span>

  <!-- The sprite: each design's layers, drawn once -->
  <svg class="sprite" width="0" height="0" focusable="false">
    <defs>
      <clipPath id="eye-opening"><path d={OPEN_MAX_PATH}></path></clipPath>
      <clipPath id="eye-below"><path d={BELOW_PATH}></path></clipPath>
      {DESIGNS.flatMap((d) => LAYERS.filter((l) => ART[d][l]).map((l) => <symbol id={`eye-${d}-${l}`} viewBox={vb} overflow="visible" set:html={ART[d][l]} />))}
      {IRISES.map((c) => <symbol id={`iris-${c}`} viewBox={vb} overflow="visible" set:html={IRIS_ART[c]} />)}
      <symbol id="eye-white" viewBox={vb} overflow="visible"><path d={OPEN_MAX_PATH} fill="#FFFDF6"></path></symbol>
      <symbol id="eye-shade" viewBox={vb} overflow="visible" set:html={SHADE} />
    </defs>
  </svg>

  {
    layouts.map((L) => (
      <div class:list={['eyes', `eyes--${L.key}`]} style={`aspect-ratio:${L.aspect}`}>
        {L.eyes.map((e) => (
          <svg class="eye" viewBox={vb} style={e.style} data-col={e.col} data-row={e.row}>
            {ART[e.design].behind && <use href={`#eye-${e.design}-behind`} {...box} />}
            {ART[e.design].calm && <use class="calm" href={`#eye-${e.design}-calm`} {...box} />}
            <use href="#eye-white" {...box} />
            <g clip-path="url(#eye-opening)">
              <use class="look" href={`#iris-${e.iris}`} {...box} />
              <use href="#eye-shade" {...box} />
              <use class="cover" href={`#eye-${e.design}-cover`} {...box} />
              <use class="lid" href={`#eye-${e.design}-lid`} {...box} />
            </g>
            {ART[e.design].front && <use href={`#eye-${e.design}-front`} {...box} />}
            <use class="upper" href={`#eye-${e.design}-upper`} {...box} />
            <g class="lower">
              <use href={`#eye-${e.design}-lower`} {...box} />
              {ART[e.design].drop && (
                <g clip-path="url(#eye-below)">
                  <use class="drop" href={`#eye-${e.design}-drop`} {...box} />
                </g>
              )}
            </g>
          </svg>
        ))}
      </div>
    ))
  }
</div>

<script>
  import { startEyes } from '../scripts/eyes';
  startEyes();
</script>

<style>
  .eyes-band {
    position: relative;
    overflow: hidden;
    background: var(--eyes-bg);
  }
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* One layout per breakpoint; the strip keeps that layout's aspect ratio */
  .eyes {
    position: relative;
    display: none;
  }
  .eyes--p {
    display: block;
  }
  @media (min-width: 560px) {
    .eyes--p {
      display: none;
    }
    .eyes--m {
      display: block;
    }
  }
  @media (min-width: 900px) {
    .eyes--m {
      display: none;
    }
    .eyes--d {
      display: block;
    }
  }
  /*
    The desktop pattern is generated 1.4× wider than it shows (eye-art.ts), and centered, so the
    band (overflow: hidden) crops it. Up to 1440px it scales with the screen; past that the strip
    keeps its height and simply shows more of the pattern, edge to edge, up to a 2016px screen.
  */
  @media (min-width: 900px) {
    .eyes--d {
      width: 140%;
      margin-left: -20%;
    }
  }
  @media (min-width: 1441px) {
    .eyes--d {
      width: 2016px;
      margin-left: calc(50% - 1008px);
    }
  }
  .eye {
    position: absolute;
    height: auto;
    overflow: visible;
    transform-origin: 50% 50%;
  }
  /* eyes.ts moves these with transform only; the matrices it writes are in the eye's own units */
  .look,
  .lid,
  .cover,
  .upper,
  .lower,
  .drop,
  .calm {
    transform-box: view-box;
    transform-origin: 0 0;
  }
  /* The hanging lashes start tucked up out of sight behind the lower lid line (eyes.ts: DROP_HIDE) */
  .drop {
    transform: translate(0, -44px);
  }
</style>
