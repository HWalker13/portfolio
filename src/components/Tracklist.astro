---
/*
  Quick tracklist: the back of the album sleeve, lying across the orange stage's edge.
  All four projects in one compact list (number, name, one line, proof links), so a recruiter
  sees everything in five seconds. Each name jumps to that project's section in the reel.
*/
import { getCollection } from 'astro:content';
import Track from './Track.astro';
import Ribbon from './Ribbon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.track - b.data.track);
const sides = (['A', 'B'] as const).map((side) => ({
  side,
  tracks: projects.filter((p) => p.data.side === side),
}));
---

<section class="sleeve container" id="tracklist" aria-labelledby="tracklist-title">
  <div class="sleeve-inner sleeve-inner--ribbon">
    <div class="sleeve-head">
      <h2 id="tracklist-title">Tracklist</h2>
      <!-- DRAFT: Holden to edit -->
      <p class="lede">Four projects. Each one links to something you can check yourself: an app, a package or a repo.</p>
    </div>
    <Ribbon class="tracklist-ribbon">
    <div class="sides">
      {
        sides.map(({ side, tracks }) => (
          <section class="side" aria-labelledby={`side-${side}`}>
            <h3 id={`side-${side}`}>
              Side {side}
            </h3>
            <ol class="tracks" start={tracks[0]?.data.track}>
              {tracks.map((entry) => (
                <Track entry={entry} />
              ))}
            </ol>
          </section>
        ))
      }
    </div>
    </Ribbon>
  </div>
</section>

<style>
  .lede {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }
  .sleeve :global(.tracklist-ribbon) {
    margin-top: var(--space-4);
  }
  /* Room below the sleeve so its shadow falls on cream, not on the eyes band */
  .sleeve {
    margin-bottom: var(--space-6);
  }

  .sides {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 960px) {
    .sides {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
  h3 {
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--text);
  }
  .tracks {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }
</style>
