---
/*
  The record labels, shared by the turntable and the record pinned on the Let's talk board.
  One ORIGINAL design per record (color, simple shapes, type), printing the album title, the
  artist and "Side One", the way real labels do. No cover art, no real record-company names or
  logos. Drawn centered on (0, 0) with radius LR = 76, as a list of <g data-record> groups; only
  the current one is displayed. turntable.ts switches the turntable's; PinnedRecord follows it.
*/
import records from '../data/records.json';

interface Props {
  /** Prefix for clipPath ids, unique per instance on the page */
  uid: string;
}
const { uid } = Astro.props;

const LR = 76;

/** Split a long title into two balanced lines at a word boundary. */
function titleLines(title: string): string[] {
  if (title.length <= 13) return [title];
  const words = title.split(' ');
  let best: string[] = [title];
  let bestMax = Infinity;
  for (let i = 1; i < words.length; i++) {
    const a = words.slice(0, i).join(' ');
    const b = words.slice(i).join(' ');
    const m = Math.max(a.length, b.length);
    if (m < bestMax) [best, bestMax] = [[a, b], m];
  }
  return best;
}

const labels = records.map((rec, i) => {
  const lines = titleLines(rec.album);
  const longest = Math.max(...lines.map((l) => l.length));
  // Fit the widest line into ~118 units at Fraunces' ~0.6em average glyph width; cap the size.
  const titleSize = +Math.min(15, 118 / (longest * 0.6)).toFixed(2);
  const lineHeight = titleSize * 1.06;
  // The Jill Scott label carries a subtitle under the title, so its title block sits a little higher.
  const shift = rec.label.detail === 'subtitle' ? -8 : 0;
  const artistSize = +Math.min(11, 116 / (rec.artist.length * 0.56)).toFixed(2);
  return {
    ...rec,
    i,
    lines: lines.map((text, k) => ({ text, y: +(-13 + shift - (lines.length - 1 - k) * lineHeight).toFixed(2) })),
    // These details take the underline's place
    underline: !['piano', 'ekg', 'bass', 'vine'].includes(rec.label.detail),
    titleSize,
    artistSize,
  };
});

const range = (from: number, to: number, step: number) =>
  Array.from({ length: Math.floor((to - from) / step) + 1 }, (_, k) => from + k * step);

---

{
  labels.map((l) => (
    <g class="label" data-record={l.i} data-current={l.i === 0 ? '' : undefined} display={l.i === 0 ? undefined : 'none'}>
      <clipPath id={`${uid}-lc-${l.i}`}>
        <circle r={LR} />
      </clipPath>
      <circle r={LR} fill={l.label.bg} />
      <g clip-path={`url(#${uid}-lc-${l.i})`}>
        {l.label.motif === 'stripes' && (
          <>
            <rect x={-LR} y="-71" width={LR * 2} height="5" fill={l.label.accent} />
            <rect x={-LR} y="-64" width={LR * 2} height="5" fill="#E0A526" />
            <rect x={-LR} y="-57" width={LR * 2} height="5" fill={l.label.accent2} />
          </>
        )}
        {l.label.motif === 'dots' &&
          [-67, -59, -51].map((y) => range(-44, 44, 11).map((x) => <circle cx={x} cy={y} r="2.3" fill={l.label.accent} />))}
        {l.label.motif === 'bars' &&
          [8, 14, 10, 18, 12, 20, 9, 15, 11].map((h, k) => (
            <rect x={-38 + k * 9} y={-49 - h} width="5" height={h} rx="1" fill={k === 5 ? l.label.accent2 : l.label.accent} />
          ))}
        {l.label.motif === 'moon' && (
          <>
            <circle cx="0" cy="-60" r="10" fill={l.label.accent} />
            <circle cx="4.5" cy="-63" r="9" fill={l.label.bg} />
            {[[-26, -59, 1.7], [24, -65, 1.5], [31, -54, 1.2], [-17, -68, 1.2], [-34, -51, 1]].map(([x, y, r]) => (
              <circle cx={x} cy={y} r={r} fill={l.label.accent2} />
            ))}
          </>
        )}
        {l.label.motif === 'waves' &&
          [
            [-63, l.label.accent],
            [-54, l.label.accent2],
          ].map(([y, c]) => (
            <path
              d={`M -66 ${y} ${range(0, 10, 1).map((k) => `q 6.6 ${k % 2 ? 5 : -5} 13.2 0`).join(' ')}`}
              fill="none"
              stroke={c as string}
              stroke-width="2.6"
              stroke-linecap="round"
            />
          ))}
        {l.label.motif === 'checker' &&
          [-67, -60].map((y, row) =>
            range(-49, 42, 7).map((x, k) => (
              <rect x={x} y={y} width="7" height="7" fill={(k + row) % 2 ? l.label.accent : l.label.accent2} />
            )),
          )}
        {l.label.motif === 'diamonds' &&
          range(-48, 48, 12).map((x, k) => (
            <polygon points={`${x},-66 ${x + 5.5},-59 ${x},-52 ${x - 5.5},-59`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
          ))}
        {l.label.motif === 'zigzag' &&
          range(-66, 54, 12).map((x, k) => (
            <polygon points={`${x},-52 ${x + 6},-65 ${x + 12},-52`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
          ))}
        {l.label.motif === 'scallops' &&
          range(-60, 60, 12).map((x, k) => (
            <path d={`M ${x - 6} -53 A 6 6 0 0 1 ${x + 6} -53 Z`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
          ))}
        {l.underline && <rect x="-32" y="46" width="64" height="2.5" rx="1.25" fill={l.label.accent} />}

        {/*
          One signature detail per label, drawn from the album's title or sound, never its cover.
          All decorative; the only text is the Jill Scott subtitle (and the plaque's "NW8").
        */}
        {l.label.detail === 'piano' && (
          <g class="detail">
            {range(0, 7, 1).map((k) => (
              <rect x={-32 + k * 8} y="40" width="8" height="12" fill="#FBF4E4" stroke={l.label.ink} stroke-width="0.7" />
            ))}
            {[1, 2, 4, 5, 6].map((k) => (
              <rect x={-32 + k * 8 - 2.3} y="40" width="4.6" height="7" fill={l.label.ink} />
            ))}
          </g>
        )}
        {l.label.detail === 'ekg' && (
          <polyline
            class="detail"
            points="-34,47 -11,47 -8,47 -5,39 -1.5,55 2,43 5,47 34,47"
            fill="none"
            stroke={l.label.accent}
            stroke-width="1.8"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        )}
        {l.label.detail === 'bass' && (
          <path class="detail" d="M -34 47 q 8.5 -9 17 0 t 17 0 t 17 0 t 17 0" fill="none" stroke={l.label.ink} stroke-width="2.2" stroke-linecap="round" />
        )}
        {l.label.detail === 'clock' && (
          <g class="detail" fill="none" stroke={l.label.accent}>
            <circle cx="0" cy="60" r="7" stroke-width="1.4" />
            {[0, 90, 180, 270].map((d) => (
              <line x1="0" y1="54.2" x2="0" y2="55.4" stroke-width="1" transform={`rotate(${d} 0 60)`} />
            ))}
            {/* Both hands at 12: midnight */}
            <line x1="0" y1="60" x2="0" y2="54.8" stroke-width="1" stroke-linecap="round" />
            <line x1="0" y1="60" x2="0" y2="56.6" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="0" cy="60" r="0.9" fill={l.label.accent} stroke="none" />
          </g>
        )}
        {l.label.detail === 'vine' && (
          <g class="detail">
            <path d="M -34 47 q 8.5 -5 17 0 t 17 0 t 17 0 t 17 0" fill="none" stroke={l.label.accent} stroke-width="1.4" stroke-linecap="round" />
            {[
              [-25.5, 44.6, -35],
              [-8.5, 49.4, 35],
              [8.5, 44.6, -35],
              [25.5, 49.4, 35],
            ].map(([x, y, a], k) => (
              <ellipse cx={x} cy={y} rx="3.8" ry="1.9" transform={`rotate(${a} ${x} ${y})`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
            ))}
          </g>
        )}
        {l.label.detail === 'notebook' && (
          <g class="detail">
            {/* Ruled lines a shade DARKER than the label, so the cream artist text keeps (and gains) contrast */}
            {[8.5, 15.5, 22.5, 29.5].map((y) => {
              const half = +Math.sqrt(72 * 72 - y * y).toFixed(1); // stop just inside the label's rim
              return <line x1={-half} y1={y} x2={half} y2={y} stroke="#7D2F10" stroke-width="0.8" />;
            })}
            <line x1="-44" y1="3" x2="-44" y2="38" stroke="#E8473A" stroke-width="1.1" />
          </g>
        )}
        {l.label.detail === 'plaque' && (
          <g class="detail">
            {/* A street-name plaque: white panel, dark border, postcode in the corner */}
            <rect x="-55" y="-31" width="110" height="26" rx="2.5" fill="#FFFFFF" stroke={l.label.ink} stroke-width="1.6" />
            <text class="label-plaque-code" x="51" y="-26" font-size="5" text-anchor="end" fill={l.label.accent}>
              NW8
            </text>
          </g>
        )}
        {l.label.detail === 'paisley' && (
          <g class="detail">
            {[
              [-44, 48, -1],
              [44, 48, 1],
            ].map(([x, y, flip]) => (
              <g transform={`translate(${x} ${y}) scale(${flip} 1)`}>
                <path
                  d="M 0 6 C -5 6 -6 0 -3 -3 C -1 -5 2 -6 3 -9 C 3.6 -5 5.5 -1.5 4.2 2 C 3.5 4.6 2 6 0 6 Z"
                  fill={l.label.accent2}
                  stroke={l.label.ink}
                  stroke-width="0.6"
                />
                <path d="M 0 3.6 C -2.4 3.6 -3 0.6 -1.4 -1.2" fill="none" stroke={l.label.ink} stroke-width="0.5" />
                <circle cx="0.6" cy="1.6" r="1.2" fill={l.label.accent} />
              </g>
            ))}
          </g>
        )}
      </g>
      <circle r={LR - 1.5} fill="none" stroke={l.label.accent} stroke-width="1.5" stroke-opacity="0.85" />
      <text class="label-title" fill={l.label.ink} font-size={l.titleSize} text-anchor="middle">
        {l.lines.map((line) => (
          <tspan x="0" y={line.y}>
            {line.text}
          </tspan>
        ))}
      </text>
      {l.label.subtitle && (
        <text class="label-sub" y="-7" fill={l.label.ink} font-size="8" text-anchor="middle">
          {l.label.subtitle}
        </text>
      )}
      <text class="label-artist" y="21" fill={l.label.ink} font-size={l.artistSize} text-anchor="middle">
        {l.artist}
      </text>
      <text class="label-side" y="35" fill={l.label.ink} font-size="6.6" text-anchor="middle" letter-spacing="1.6">
        SIDE ONE
      </text>
    </g>
  ))
}

<style>
  .label-title {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 800;
  }
  .label-artist {
    font-family: var(--font-body);
    font-weight: 700;
  }
  /*
    Hidden unless it's on the record that's playing: Chrome fetches a web font for text inside a
    hidden <g>, but not for text that is itself display:none. This keeps Caveat off the page load.
  */
  .label-sub {
    display: none;
    font-family: 'Caveat Variable', 'Segoe Script', cursive;
    font-weight: 600;
  }
  .label-plaque-code {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.3px;
  }
  /*
    The subtitle is 8 label units; the record spans 70% of the turntable's 500 units,
    so it renders at 8 × width / 500 px. Under 7px (width < 437.5px) it's hidden;
    the Now playing caption already carries the title.
  */
  @container (min-width: 437.5px) {
    .label[data-current] .label-sub {
      display: inline;
    }
  }
  .label-side {
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
