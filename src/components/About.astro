---
/* About: the credits on the inside of the sleeve, between the reel and Let's talk. */
import { site } from '../data/site';
---

<section class="about container" id="about" aria-labelledby="about-title">
  <div class="sleeve-inner">
  <h2 id="about-title" tabindex="-1">About</h2>
  <div class="cols">
    <div class="prose">
      <p>
        I'm a CS student at CSU San Bernardino, graduating in May 2027. I like building things people actually use.
        I co-founded Lovely, which is live on the App Store, and built its backend, from the AI gateway to
        subscription billing. I also like knowing how systems work under the hood, so I build things like a
        Redis-style cache from raw sockets just to see what breaks. But I don't lose sight of the point: the goal
        is something that ships and works.
      </p>
    </div>
    <dl class="credits">
      <dt>Experience</dt>
      {
        site.experience.map((e) => (
          <dd class="role">
            <strong>{e.role}</strong>, {e.rest}
          </dd>
        ))
      }
      <dt class="next">Stack I actually use</dt>
      <dd>{site.stack.join(' · ')}</dd>
    </dl>
  </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-6);
  }
  h2:focus {
    outline: none;
  }
  .cols {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 960px) {
    .cols {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-6);
    }
  }
  .credits {
    padding: var(--space-4);
    border: 2px solid var(--text);
    border-radius: var(--radius);
    align-self: start;
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  dd {
    margin: var(--space-2) 0 0;
    font-weight: 600;
    line-height: 1.7;
  }
  .role {
    font-weight: 400;
    line-height: 1.45;
  }
  .role strong {
    font-weight: 700;
  }
  .role + .role {
    margin-top: var(--space-1);
  }
  dt.next {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
</style>
