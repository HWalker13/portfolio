---
import type { CollectionEntry } from 'astro:content';
import ProofLinks from './ProofLinks.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, track, tagline, proof } = entry.data;
// Jumps to this project's section in the reel on the same page.
const href = `#${entry.id}`;
// Each track's record gets its own label color.
const LABELS = ['var(--burnt-orange)', 'var(--mustard)', 'var(--avocado)', 'var(--walnut)'];
const label = LABELS[(track - 1) % LABELS.length];
---

<!--
  Each track is a sleeve. A small record sits behind it and slides partway out of the right
  edge on hover or keyboard focus (transform only, so it never triggers layout).
-->
<li class="track" style={`--label: ${label}`}>
  <span class="peek" aria-hidden="true"><span class="peek-label"></span></span>
  <div class="card">
  <span class="num" aria-hidden="true">{track}</span>
  <div class="body">
    <h4>
      <span class="visually-hidden">Track {track}: </span>
      <a href={href}>{title}</a>
    </h4>
    <p class="tagline">{tagline}</p>
    <div class="links">
      <ProofLinks project={title} proof={proof} />
    </div>
  </div>
  </div>
</li>

<style>
  .track {
    position: relative;
    isolation: isolate;
    /* How far the record slides out past the sleeve's edge */
    --peek-out: 24px;
    --peek-size: 64px;
  }
  .track + .track {
    margin-top: var(--space-3);
  }

  /* The sleeve: a cream panel with a 70s offset block shadow */
  .card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-2) var(--space-3);
    background: var(--bg);
    border: 2px solid var(--text);
    border-radius: 8px;
    box-shadow: 5px 5px 0 var(--band-2);
  }

  /* The record behind the sleeve. Hidden under the card until it slides out. */
  .peek {
    position: absolute;
    z-index: 0;
    top: 1.1rem;
    right: 8px;
    width: var(--peek-size);
    height: var(--peek-size);
    border-radius: 50%;
    background:
      conic-gradient(from 30deg, transparent 0 20deg, rgb(255 255 255 / 0.16) 40deg, transparent 60deg 200deg, rgb(255 255 255 / 0.1) 220deg, transparent 240deg),
      repeating-radial-gradient(circle, #141110 0 1.2px, #221d1a 1.2px 2.2px);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
    transition: transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  .peek-label {
    position: absolute;
    inset: 34%;
    border-radius: 50%;
    background:
      radial-gradient(circle, #1e140d 0 1.6px, transparent 2px),
      linear-gradient(transparent 0 58%, var(--mustard) 58% 70%, transparent 70%),
      var(--label);
  }
  .track:hover .peek,
  .track:focus-within .peek {
    /* Slide right past the card edge (8px inset + peek-out) and roll a little, like pulling a record */
    transform: translateX(calc(var(--peek-out) + 8px)) rotate(50deg);
  }
  /* Reduced motion: no slide, the record simply appears in place */
  @media (prefers-reduced-motion: reduce) {
    .peek {
      transition: none;
    }
  }
  .num {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 900;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--link);
    text-align: right;
  }
  h4 {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  h4 a {
    color: var(--text);
    text-decoration-color: var(--burnt-orange);
    text-decoration-thickness: 0.1em;
  }
  h4 a:hover {
    color: var(--link);
  }
  .tagline {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .links {
    margin-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
  }
</style>
