---
/*
  A 70s turntable drawn in SVG. Everything is positioned in one coordinate space,
  500 × 400 units (the plinth), using percentages so the whole thing scales with its width:
    - platter + record center: (200, 200). Platter r = 175, vinyl r = 165, label r = 76
    - grooves from the lead-in (r 152) to the run-out (r 86); physics.ts ARM_GEOMETRY matches
    - tonearm pivot: (430, 70)
  Layers, bottom to top:
    1. .plinth   static SVG: wood, platter well, tonearm rest
    2. .record   the grab target (not rotated, but it slides during a record swap);
                 contains .disc, the only element that spins
    3. .sheen    a fixed CSS conic-gradient highlight, so the grooves rotate *under* the light
    4. .arm      tonearm SVG, rotated around its pivot
  Below the plinth: Start/Stop and Switch record (real <button>s) and the Now playing caption.
  The spinning part is an HTML element, not an SVG <g>, so the browser can rasterize it once
  and rotate it on the compositor. Rotating an SVG group would repaint every frame.

  Behavior lives in src/scripts/turntable.ts (a custom element), physics in physics.ts.
*/

import records from '../data/records.json';
// Handwriting face for one label's subtitle. Browsers only download a font when visible text
// uses it, and that label is hidden until its record plays, so this costs nothing on page load.
import '@fontsource-variable/caveat';

const uid = `tt-${Math.random().toString(36).slice(2, 8)}`;

/** Deterministic PRNG so the wood grain is identical on every build. */
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(1973);
const r = (min: number, max: number) => +(min + rand() * (max - min)).toFixed(1);

// Wood grain: long, gently wavy strokes across the plinth.
const grain = Array.from({ length: 26 }, (_, i) => {
  const y = 6 + i * 15.5 + r(-4, 4);
  return {
    d: `M -10 ${y} C 120 ${y + r(-9, 9)}, 300 ${y + r(-9, 9)}, 510 ${y + r(-6, 6)}`,
    dark: rand() > 0.35,
    w: r(0.6, 2.6),
  };
});

// Grooves from the run-out (r 88) to the lead-in (r 160), with a few smooth gaps between tracks.
const GAPS = [
  [106, 110],
  [130, 134],
];
const grooves: { r: number; light: boolean }[] = [];
for (let radius = 88, i = 0; radius <= 160; radius += 1.45, i++) {
  if (GAPS.some(([a, b]) => radius > a! && radius < b!)) continue;
  grooves.push({ r: +radius.toFixed(2), light: i % 3 !== 0 });
}

/*
  Center labels: one ORIGINAL design per record (color, simple shapes, type), printing the
  album title, the artist and "Side One", the way real labels do. No cover art, no real
  record-company names or logos. Label radius 76 (46% of the vinyl), in the disc's coordinate space.
  Layout: motif band at the top, title above the spindle hole, artist and side below.
*/
const LR = 76;

/** Split a long title into two balanced lines at a word boundary. */
function titleLines(title: string): string[] {
  if (title.length <= 13) return [title];
  const words = title.split(' ');
  let best: string[] = [title];
  let bestMax = Infinity;
  for (let i = 1; i < words.length; i++) {
    const a = words.slice(0, i).join(' ');
    const b = words.slice(i).join(' ');
    const m = Math.max(a.length, b.length);
    if (m < bestMax) [best, bestMax] = [[a, b], m];
  }
  return best;
}

const labels = records.map((rec, i) => {
  const lines = titleLines(rec.album);
  const longest = Math.max(...lines.map((l) => l.length));
  // Fit the widest line into ~118 units at Fraunces' ~0.6em average glyph width; cap the size.
  const titleSize = +Math.min(15, 118 / (longest * 0.6)).toFixed(2);
  const lineHeight = titleSize * 1.06;
  // The Jill Scott label carries a subtitle under the title, so its title block sits a little higher.
  const shift = rec.label.detail === 'subtitle' ? -8 : 0;
  const artistSize = +Math.min(11, 116 / (rec.artist.length * 0.56)).toFixed(2);
  return {
    ...rec,
    i,
    lines: lines.map((text, k) => ({ text, y: +(-13 + shift - (lines.length - 1 - k) * lineHeight).toFixed(2) })),
    // These details take the underline's place
    underline: !['piano', 'ekg', 'bass', 'vine'].includes(rec.label.detail),
    titleSize,
    artistSize,
  };
});

const range = (from: number, to: number, step: number) =>
  Array.from({ length: Math.floor((to - from) / step) + 1 }, (_, k) => from + k * step);

// Strobe dots on the platter rim. They rotate with the platter, which adds another motion cue.
const strobe = Array.from({ length: 72 }, (_, i) => i * 5);
---

<turn-table class="turntable-unit">
  <div class="turntable">
  <svg class="plinth" viewBox="0 0 500 400" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${uid}-walnut`} x1="0" y1="0" x2="0.15" y2="1">
        <stop offset="0" stop-color="#83552f"></stop>
        <stop offset="0.45" stop-color="#6e4527"></stop>
        <stop offset="1" stop-color="#583619"></stop>
      </linearGradient>
      <radialGradient id={`${uid}-well`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0.9" stop-color="#1a0f08" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#1a0f08" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id={`${uid}-chrome`} cx="0.35" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#f4efe6"></stop>
        <stop offset="0.6" stop-color="#b9b2a6"></stop>
        <stop offset="1" stop-color="#7d776d"></stop>
      </radialGradient>
      <clipPath id={`${uid}-plinth-clip`}>
        <rect x="0" y="0" width="500" height="400" rx="22"></rect>
      </clipPath>
    </defs>

    <rect x="0" y="0" width="500" height="400" rx="22" fill={`url(#${uid}-walnut)`}></rect>
    <g clip-path={`url(#${uid}-plinth-clip)`} fill="none">
      {
        grain.map((g) => (
          <path
            d={g.d}
            stroke={g.dark ? '#2b170a' : '#c48a55'}
            stroke-opacity={g.dark ? 0.28 : 0.12}
            stroke-width={g.w}
          />
        ))
      }
    </g>
    <!-- Bevel: light top edge, dark bottom edge -->
    <rect x="1.5" y="1.5" width="497" height="397" rx="21" fill="none" stroke="#f3e6cc" stroke-opacity="0.18" stroke-width="2"></rect>
    <rect x="10" y="10" width="480" height="380" rx="15" fill="none" stroke="#1a0f08" stroke-opacity="0.35" stroke-width="1.5"></rect>

    <!-- Recessed well under the platter -->
    <circle cx="200" cy="203" r="186" fill={`url(#${uid}-well)`}></circle>

    <!-- Tonearm base plate and rest post -->
    <circle cx="430" cy="70" r="34" fill="#1a0f08" fill-opacity="0.35"></circle>
    <circle cx="430" cy="70" r="30" fill={`url(#${uid}-chrome)`}></circle>
    <!-- Rest post sits under the tube's resting position, so the arm visibly lands on it when stopped -->
    <circle cx="430" cy="236" r="8" fill="#1a0f08" fill-opacity="0.35"></circle>
    <circle cx="430" cy="234" r="7" fill={`url(#${uid}-chrome)`}></circle>
  </svg>

  <div
    class="record"
    tabindex="0"
    role="group"
    aria-roledescription="record"
    aria-label="Vinyl record. Drag to spin it, or drag backwards to scratch. Playing moves the tonearm across the side."
    aria-describedby={`${uid}-hint`}
  >
    <div class="disc">
      <svg viewBox="-175 -175 350 350" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id={`${uid}-platter`} cx="0" cy="0" r="175" gradientUnits="userSpaceOnUse">
            <stop offset="0.9" stop-color="#9c968c"></stop>
            <stop offset="0.96" stop-color="#d8d2c7"></stop>
            <stop offset="1" stop-color="#77716a"></stop>
          </radialGradient>
          <clipPath id={`${uid}-label-clip`}>
            <circle r={LR}></circle>
          </clipPath>
          <path id={`${uid}-matrix-arc`} d="M 0 82 A 82 82 0 1 1 0.01 82"></path>
        </defs>

        <!-- Platter rim with strobe dots -->
        <circle r="175" fill={`url(#${uid}-platter)`}></circle>
        <g fill="#2b2622">
          {strobe.map((deg) => <rect x="-1.4" y="-173" width="2.8" height="4" transform={`rotate(${deg})`} />)}
        </g>

        <!-- Vinyl -->
        <circle r="165" fill="#141110"></circle>
        <g fill="none" stroke-width="0.7">
          {
            grooves.map((g) => (
              <circle r={g.r} stroke={g.light ? '#ffffff' : '#000000'} stroke-opacity={g.light ? 0.07 : 0.6} />
            ))
          }
        </g>
        <!-- Gaps between tracks and the lead-in read as glossier bands -->
        {GAPS.map(([a, b]) => <circle r={(a! + b!) / 2} fill="none" stroke="#080707" stroke-width="4" />)}
        <circle r="163" fill="none" stroke="#0b0909" stroke-width="3.5"></circle>

        <!-- Etching in the dead wax (an asymmetric detail that shows the spin) -->
        <text class="matrix" font-size="4.6" fill="#ffffff" fill-opacity="0.28" letter-spacing="1.2">
          <textPath href={`#${uid}-matrix-arc`}>33 1/3 RPM · STEREO · SIDE ONE</textPath>
        </text>

        <!-- Center labels: only the current record's is shown; turntable.ts switches them during a swap. -->
        {
          labels.map((l) => (
            <g class="label" data-record={l.i} data-current={l.i === 0 ? '' : undefined} display={l.i === 0 ? undefined : 'none'}>
              <clipPath id={`${uid}-lc-${l.i}`}>
                <circle r={LR} />
              </clipPath>
              <circle r={LR} fill={l.label.bg} />
              <g clip-path={`url(#${uid}-lc-${l.i})`}>
                {l.label.motif === 'stripes' && (
                  <>
                    <rect x={-LR} y="-71" width={LR * 2} height="5" fill={l.label.accent} />
                    <rect x={-LR} y="-64" width={LR * 2} height="5" fill="#E0A526" />
                    <rect x={-LR} y="-57" width={LR * 2} height="5" fill={l.label.accent2} />
                  </>
                )}
                {l.label.motif === 'dots' &&
                  [-67, -59, -51].map((y) => range(-44, 44, 11).map((x) => <circle cx={x} cy={y} r="2.3" fill={l.label.accent} />))}
                {l.label.motif === 'bars' &&
                  [8, 14, 10, 18, 12, 20, 9, 15, 11].map((h, k) => (
                    <rect x={-38 + k * 9} y={-49 - h} width="5" height={h} rx="1" fill={k === 5 ? l.label.accent2 : l.label.accent} />
                  ))}
                {l.label.motif === 'moon' && (
                  <>
                    <circle cx="0" cy="-60" r="10" fill={l.label.accent} />
                    <circle cx="4.5" cy="-63" r="9" fill={l.label.bg} />
                    {[[-26, -59, 1.7], [24, -65, 1.5], [31, -54, 1.2], [-17, -68, 1.2], [-34, -51, 1]].map(([x, y, r]) => (
                      <circle cx={x} cy={y} r={r} fill={l.label.accent2} />
                    ))}
                  </>
                )}
                {l.label.motif === 'waves' &&
                  [
                    [-63, l.label.accent],
                    [-54, l.label.accent2],
                  ].map(([y, c]) => (
                    <path
                      d={`M -66 ${y} ${range(0, 10, 1).map((k) => `q 6.6 ${k % 2 ? 5 : -5} 13.2 0`).join(' ')}`}
                      fill="none"
                      stroke={c as string}
                      stroke-width="2.6"
                      stroke-linecap="round"
                    />
                  ))}
                {l.label.motif === 'checker' &&
                  [-67, -60].map((y, row) =>
                    range(-49, 42, 7).map((x, k) => (
                      <rect x={x} y={y} width="7" height="7" fill={(k + row) % 2 ? l.label.accent : l.label.accent2} />
                    )),
                  )}
                {l.label.motif === 'diamonds' &&
                  range(-48, 48, 12).map((x, k) => (
                    <polygon points={`${x},-66 ${x + 5.5},-59 ${x},-52 ${x - 5.5},-59`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
                  ))}
                {l.label.motif === 'zigzag' &&
                  range(-66, 54, 12).map((x, k) => (
                    <polygon points={`${x},-52 ${x + 6},-65 ${x + 12},-52`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
                  ))}
                {l.label.motif === 'scallops' &&
                  range(-60, 60, 12).map((x, k) => (
                    <path d={`M ${x - 6} -53 A 6 6 0 0 1 ${x + 6} -53 Z`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
                  ))}
                {l.underline && <rect x="-32" y="46" width="64" height="2.5" rx="1.25" fill={l.label.accent} />}

                {/*
                  One signature detail per label, drawn from the album's title or sound, never its cover.
                  All decorative; the only text is the Jill Scott subtitle (and the plaque's "NW8").
                */}
                {l.label.detail === 'piano' && (
                  <g class="detail">
                    {range(0, 7, 1).map((k) => (
                      <rect x={-32 + k * 8} y="40" width="8" height="12" fill="#FBF4E4" stroke={l.label.ink} stroke-width="0.7" />
                    ))}
                    {[1, 2, 4, 5, 6].map((k) => (
                      <rect x={-32 + k * 8 - 2.3} y="40" width="4.6" height="7" fill={l.label.ink} />
                    ))}
                  </g>
                )}
                {l.label.detail === 'ekg' && (
                  <polyline
                    class="detail"
                    points="-34,47 -11,47 -8,47 -5,39 -1.5,55 2,43 5,47 34,47"
                    fill="none"
                    stroke={l.label.accent}
                    stroke-width="1.8"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />
                )}
                {l.label.detail === 'bass' && (
                  <path class="detail" d="M -34 47 q 8.5 -9 17 0 t 17 0 t 17 0 t 17 0" fill="none" stroke={l.label.ink} stroke-width="2.2" stroke-linecap="round" />
                )}
                {l.label.detail === 'clock' && (
                  <g class="detail" fill="none" stroke={l.label.accent}>
                    <circle cx="0" cy="60" r="7" stroke-width="1.4" />
                    {[0, 90, 180, 270].map((d) => (
                      <line x1="0" y1="54.2" x2="0" y2="55.4" stroke-width="1" transform={`rotate(${d} 0 60)`} />
                    ))}
                    {/* Both hands at 12: midnight */}
                    <line x1="0" y1="60" x2="0" y2="54.8" stroke-width="1" stroke-linecap="round" />
                    <line x1="0" y1="60" x2="0" y2="56.6" stroke-width="1.8" stroke-linecap="round" />
                    <circle cx="0" cy="60" r="0.9" fill={l.label.accent} stroke="none" />
                  </g>
                )}
                {l.label.detail === 'vine' && (
                  <g class="detail">
                    <path d="M -34 47 q 8.5 -5 17 0 t 17 0 t 17 0 t 17 0" fill="none" stroke={l.label.accent} stroke-width="1.4" stroke-linecap="round" />
                    {[
                      [-25.5, 44.6, -35],
                      [-8.5, 49.4, 35],
                      [8.5, 44.6, -35],
                      [25.5, 49.4, 35],
                    ].map(([x, y, a], k) => (
                      <ellipse cx={x} cy={y} rx="3.8" ry="1.9" transform={`rotate(${a} ${x} ${y})`} fill={k % 2 ? l.label.accent2 : l.label.accent} />
                    ))}
                  </g>
                )}
                {l.label.detail === 'notebook' && (
                  <g class="detail">
                    {/* Ruled lines a shade DARKER than the label, so the cream artist text keeps (and gains) contrast */}
                    {[8.5, 15.5, 22.5, 29.5].map((y) => {
                      const half = +Math.sqrt(72 * 72 - y * y).toFixed(1); // stop just inside the label's rim
                      return <line x1={-half} y1={y} x2={half} y2={y} stroke="#7D2F10" stroke-width="0.8" />;
                    })}
                    <line x1="-44" y1="3" x2="-44" y2="38" stroke="#E8473A" stroke-width="1.1" />
                  </g>
                )}
                {l.label.detail === 'plaque' && (
                  <g class="detail">
                    {/* A street-name plaque: white panel, dark border, postcode in the corner */}
                    <rect x="-55" y="-31" width="110" height="26" rx="2.5" fill="#FFFFFF" stroke={l.label.ink} stroke-width="1.6" />
                    <text class="label-plaque-code" x="51" y="-26" font-size="5" text-anchor="end" fill={l.label.accent}>
                      NW8
                    </text>
                  </g>
                )}
                {l.label.detail === 'paisley' && (
                  <g class="detail">
                    {[
                      [-44, 48, -1],
                      [44, 48, 1],
                    ].map(([x, y, flip]) => (
                      <g transform={`translate(${x} ${y}) scale(${flip} 1)`}>
                        <path
                          d="M 0 6 C -5 6 -6 0 -3 -3 C -1 -5 2 -6 3 -9 C 3.6 -5 5.5 -1.5 4.2 2 C 3.5 4.6 2 6 0 6 Z"
                          fill={l.label.accent2}
                          stroke={l.label.ink}
                          stroke-width="0.6"
                        />
                        <path d="M 0 3.6 C -2.4 3.6 -3 0.6 -1.4 -1.2" fill="none" stroke={l.label.ink} stroke-width="0.5" />
                        <circle cx="0.6" cy="1.6" r="1.2" fill={l.label.accent} />
                      </g>
                    ))}
                  </g>
                )}
              </g>
              <circle r={LR - 1.5} fill="none" stroke={l.label.accent} stroke-width="1.5" stroke-opacity="0.85" />
              <text class="label-title" fill={l.label.ink} font-size={l.titleSize} text-anchor="middle">
                {l.lines.map((line) => (
                  <tspan x="0" y={line.y}>
                    {line.text}
                  </tspan>
                ))}
              </text>
              {l.label.subtitle && (
                <text class="label-sub" y="-7" fill={l.label.ink} font-size="8" text-anchor="middle">
                  {l.label.subtitle}
                </text>
              )}
              <text class="label-artist" y="21" fill={l.label.ink} font-size={l.artistSize} text-anchor="middle">
                {l.artist}
              </text>
              <text class="label-side" y="35" fill={l.label.ink} font-size="6.6" text-anchor="middle" letter-spacing="1.6">
                SIDE ONE
              </text>
            </g>
          ))
        }
        <circle r="3.6" fill="#1e140d"></circle>
      </svg>
    </div>
  </div>

  <div class="sheen" aria-hidden="true"></div>

  <!-- Tight box around the arm (x 400–460, y 8–320) so its rotated bounds never leave the plinth -->
  <svg class="arm" viewBox="400 8 60 312" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${uid}-tube`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#8b857b"></stop>
        <stop offset="0.45" stop-color="#f4efe6"></stop>
        <stop offset="1" stop-color="#8b857b"></stop>
      </linearGradient>
    </defs>
    <g class="arm-shadow" transform="translate(5 6)" fill="#1a0f08" fill-opacity="0.28" stroke="#1a0f08" stroke-opacity="0.28">
      <path d="M 430 70 L 430 262 L 424 296" fill="none" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
      <rect x="415" y="284" width="18" height="26" rx="3" transform="rotate(10 424 296)" stroke="none"></rect>
    </g>
    <!-- Counterweight -->
    <rect x="417" y="16" width="26" height="30" rx="5" fill="#3a332d"></rect>
    <rect x="417" y="22" width="26" height="4" fill="#8b857b"></rect>
    <!-- Tube -->
    <path d="M 430 40 L 430 262 L 424 296" fill="none" stroke={`url(#${uid}-tube)`} stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
    <!-- Pivot bearing -->
    <circle cx="430" cy="70" r="12" fill="#2b2622"></circle>
    <circle cx="430" cy="70" r="5" fill="#b9b2a6"></circle>
    <!-- Headshell + cartridge -->
    <g transform="rotate(10 424 296)">
      <rect x="415" y="284" width="18" height="26" rx="3" fill="#2b2622"></rect>
      <rect x="418" y="296" width="12" height="10" rx="1.5" fill="#d9622b"></rect>
      <rect x="433" y="288" width="9" height="3" rx="1.5" fill="#b9b2a6"></rect>
    </g>
  </svg>

  </div>

  <div class="controls">
    <div class="buttons">
      <button class="deck-btn motor" type="button" aria-pressed="true">
        <span class="lamp" aria-hidden="true"></span>
        <span>Start / Stop</span>
      </button>
      <button class="deck-btn switch" type="button">
        <span class="mini-record" aria-hidden="true"></span>
        <span>Switch record</span>
      </button>
    </div>
    <p class="now-playing">
      <span class="np-key">Now playing:</span>{' '}
      <span data-now-playing>{records[0]!.album} · {records[0]!.artist}</span>
    </p>
  </div>

  <p class="visually-hidden" id={`${uid}-hint`}>
    Left and Right arrow keys nudge the record. Space starts or stops the motor.
  </p>
  <!-- Announces only record changes ("Now playing: … by …"), never anything during playback -->
  <p class="visually-hidden" aria-live="polite" data-status></p>
</turn-table>

<script>
  import '../scripts/turntable';
</script>

<style>
  .turntable-unit {
    display: block;
    width: 100%;
    max-width: 560px;
    container-type: inline-size;
  }
  .turntable {
    /* 500 × 400 plinth; every child below is placed in % of that box. */
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    border-radius: 4.4% / 5.5%;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.15) inset,
      0 18px 40px -18px rgb(30 20 13 / 0.55),
      0 6px 14px -6px rgb(30 20 13 / 0.35);
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .plinth {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Platter box: center (200,200), r 175 → 350 × 350 units */
  .record {
    position: absolute;
    left: 5%;
    top: 6.25%;
    width: 70%;
    height: 87.5%;
    border-radius: 50%;
    cursor: grab;
    /* Only the record swallows touch gestures; the rest of the page scrolls normally. */
    touch-action: none;
    /* Slides (translateY) during a record swap */
    will-change: transform;
  }
  .record:active {
    cursor: grabbing;
  }
  .record:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .disc {
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .disc svg {
    width: 100%;
    height: 100%;
  }

  .label-title {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 800;
