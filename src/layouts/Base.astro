---
/*
  Fonts are self-hosted through fontsource: the same files Google Fonts serves, but
  there's no third-party request on page load.
  Fraunces uses `full.css` on purpose. The default import only ships the opsz/wght axes,
  and the soft 70s look needs the SOFT (and WONK) axes, which only the "full" files contain.
*/
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for liner-notes pages, 'website' for the home page. */
  ogType?: 'website' | 'article';
  /** Adds a schema.org Person block. Only the home page needs it. */
  person?: boolean;
  /** For the 404 page: keep it out of search results and don't claim a canonical URL. */
  noindex?: boolean;
}

const { title, description = site.description, ogType = 'website', person = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: backend & AI engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social previews need absolute URLs.
const ogImage = new URL('/og.jpg', Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  jobTitle: 'Backend & AI engineer',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'California State University, San Bernardino' },
  sameAs: [site.links.github, site.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Icons: a tiny record. SVG for modern browsers, .ico and Apple touch icon as fallbacks. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Browser chrome matches the orange stage at the top of every page -->
    <meta name="theme-color" content="#d9622b" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#8f3a16" media="(prefers-color-scheme: dark)" />

    <!-- Social previews (LinkedIn, Slack, iMessage, X) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {person && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    <!-- The display face renders the hero name, so fetch it early. (Measured: dropping this preload
         moved mobile FCP from 2.0s to 2.7s in Lighthouse.) -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <!--
      "Pause motion" (the hero's toggle) is remembered per visitor. Read it before first paint so a
      paused marquee never starts moving. Storage can throw (private mode, blocked site data).
    -->
    <script is:inline>
      try {
        if (localStorage.getItem('motion') === 'paused') document.documentElement.dataset.motion = 'paused';
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
