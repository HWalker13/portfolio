---
/*
  M2: the turntable alone on the page, for hands-on testing.
  M3 replaces this with the real home page.
*/
import Base from '../layouts/Base.astro';
import Turntable from '../components/Turntable.astro';
---

<Base title="Turntable test">
  <div class="stage container">
    <h1 class="visually-hidden">Turntable test</h1>
    <Turntable />
  </div>
</Base>

<style>
  .stage {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding-block: var(--space-5);
  }
</style>
