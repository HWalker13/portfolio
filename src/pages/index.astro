---
/*
  M1 placeholder: a type and token specimen so the scaffold can be checked at 375px and in both color schemes.
  M3 replaces it with the real home page.
*/
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
import { site } from '../data/site';
---

<Base>
  <div class="container specimen">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <Stripes />
    <h2>Side A</h2>
    <p>
      Body copy in DM Sans with a <a href={site.links.github}>link in orange ink</a>. Numbers use the mono face:{' '}
      <span class="mono">64.3%</span> vs. <span class="mono">54.4%</span> baseline.
    </p>
    <div class="card">
      <h3>A paper surface</h3>
      <p>Cards sit on <code>--surface</code>. Links here: <a href={site.links.linkedin}>LinkedIn</a>.</p>
    </div>
  </div>
</Base>

<style>
  .specimen {
    padding-block: var(--space-6);
  }
  .tagline {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  h2 {
    margin-bottom: var(--space-3);
  }
  .card {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
  }
  .card h3 {
    margin-bottom: var(--space-2);
  }
</style>
